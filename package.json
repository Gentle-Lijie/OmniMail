{
  "name": "omnimail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm --prefix frontend run dev\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p server/tsconfig.json && node server/copySkills.mjs && npm --prefix frontend run build",
    "start": "node dist/server/index.js",
    "test": "LOG_LEVEL=off tsx --test server/*.test.ts frontend/tests/*.test.ts",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@simplewebauthn/server": "^13.2.2",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^7.0.3",
    "fastify": "^5.6.1",
    "mammoth": "^1.11.0",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
