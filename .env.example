# Generate each secret: openssl rand -hex 32
APP_SECRET=replace-with-a-random-secret-at-least-32-characters
SETUP_TOKEN=replace-with-a-separate-random-token-at-least-24-characters
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/omnimail.sqlite
# Optional: seed encrypted settings on the first start. Never commit signed URLs.
OUTLOOK_MAIL_WEBHOOK_URL=
OUTLOOK_EVENT_WEBHOOK_URL=
